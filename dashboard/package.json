{
  "name": "mcp-toolgauge-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The mcp-toolgauge dashboard: findings, the confusion heatmap, and score history from a ci --json report.",
  "scripts": {
